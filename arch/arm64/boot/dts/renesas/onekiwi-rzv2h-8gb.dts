/*
 * Device Tree Source for the OneKiw RZ/V2H SOM board
 *
 * Copyright (C) 2024 Renesas Electronics Corp.
 */

/dts-v1/;
#include "onekiwi-r9a09g057.dtsi"
#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
#include <dt-bindings/gpio/gpio.h>

#define CODEC_SGTLT5000		0

/ {
	model = "OneKiwi RZ/V2H 8GB";
	compatible = "onekiwi,onekiwi-rzv2h-8gb", "renesas,r9a09g057h4", "renesas,r9a09g057";

	aliases {
		serial0 = &scif0;
		serial1 = &sci0;
        serial2 = &sci3;
		i2c1 = &i2c1;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8; 
		mmc0 = &sdhi0;
		mmc1 = &sdhi1;
		mmc2 = &sdhi2;
		ethernet0 = &eth0;
		ethernet1 = &eth1;
	};

	chosen {
		bootargs = "ignore_loglevel";
		stdout-path = "serial0:115200n8";
	};

	memory@48000000 {
		device_type = "memory";
		reg = <0x0 0x48000000 0x0 0xF8000000>;
	};

	memory@240000000 {
		device_type = "memory";
		reg = <0x2 0x40000000 0x1 0x00000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		global_cma: linux,cma@58000000 {
			compatible = "shared-dma-pool";
			linux,cma-default;
			reusable;
			reg = <0x0 0x58000000 0x0 0x28000000>;
		};

		mmp_reserved: linux,multimedia {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x00000000 0x80000000 0x0 0x10000000>;
		};

		isp_reserved: frame_buffer@90000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0x90000000 0x0 0x18000000>;
		};

		opencva_reserved: OpenCVA@A8000000 {
			reusable;
			reg = <0x0 0xA8000000 0x0 0x7D00000>;
		};

		drp_codec: DRP-Codec@AFD00000 {
			reusable;
			reg = <0x0 0xAFD00000 0x0 0x300000>;
		};

		image_buf0: image_buf@B0000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0xB0000000 0x0 0x4000000>;
			label = "image_buf0";
		};

		cru_func: cru_buffer@B4000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0xB4000000 0x0 0x16400000>;
		};

		drp_reserved: DRP-AI@240000000 {
			reusable;
			// reg = <0x2 0x40000000 0x0 0x20000000>; // size = 512 MiB
			reg = <0x2 0x40000000 0x0 0x80000000>; // size = 2GiB
		};
	};

	mmngr {
		compatible = "renesas,mmngr";
		memory-region = <&mmp_reserved>;
	};

	mmngrbuf {
		compatible = "renesas,mmngrbuf";
	};

	vspm_if {
		compatible = "renesas,vspm_if";
	};

	reg_1p8v: regulator0 {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3v: regulator1 {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	vmmc_sdhi1: regulator-vcc-sdhi1 {
		compatible = "regulator-fixed";
		regulator-name = "SDHI1 Vmmc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&pinctrl RZG2L_GPIO(10, 3) GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vccq_sdhi1: regulator-vccq-sdhi1 {
		compatible = "regulator-gpio";
		regulator-name = "SDHI1 VccQ";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		//gpios = <&pinctrl RZG2L_GPIO(10, 2) GPIO_ACTIVE_HIGH>;
		gpios-states = <1>;
		states = <3300000 0 1800000 1>;
	};

	x1_clk: x1-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	clk_ext_audio: clk_ext_audio {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <11289600>;
	};


	clk_audio_12m288: x12m288 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <12288000>;
	};

	snd_rzv2h: sound {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "simple-audio-card";
		simple-audio-card,name = "rsnd_rzv2h";
		status="okay";
#if CODEC_SGTLT5000
		simple-audio-card,widgets =
			"Headphone", "Headphone Jack",
			"Microphone", "Mic Jack",
			"Line", "Line In",
			"Line", "Line Out";
		simple-audio-card,routing =
			"Headphone Jack", "HP_OUT",
			"LINE_OUT", "Line Out",
			"Mic Jack", "MIC_IN",
			"Line In", "LINE_IN";
#else
		simple-audio-card,widgets =
			"Headphone", "Headphone Jack",
			"Microphone", "Mic Jack";
		simple-audio-card,routing =
			"Headphone Jack",	"LOUT1",
			"Headphone Jack",	"ROUT1",
			"LINPUT1", "Mic Jack",
			"RINPUT1", "Mic Jack";
#endif
		ssi_link: simple-audio-card,dai-link@0 {
			format = "i2s";
			reg = <0>;
			bitclock-master = <&cpu_dai0>;
			frame-master = <&cpu_dai0>;
			mclk-fs = <256>;

			cpu_dai0: cpu {
				sound-dai = <&rcar_sound 0>;
			};

			codec {
#if CODEC_SGTLT5000
				sound-dai = <&sgtl5000>;
				system-clock-frequency = <11289600>;
#else
				sound-dai = <&es8388>;
#endif
				clocks = <&rcar_sound>;
			};
		};
	};

	hdmi-out {
		compatible = "hdmi-connector";
		type = "d";

		port {
			hdmi_con_out: endpoint {
				remote-endpoint = <&adv7535_out>;
			};
		};
	};

	udmabuf@0 {
		compatible = "ikwzm,u-dma-buf";
		device-name = "udmabuf0";
		minor-number = <0>;
		size = <0x4000000>; // 64MiB
		dma-coherent;
		memory-region = <&image_buf0>;
	};
};

&adc {
	status = "okay";
};

&audio_clka {
	clock-frequency = <22579200>;
};

&audio_clkb {
	clock-frequency = <24576000>;
};

&audio_clkc {
	clock-frequency = <22579200>;
};

&canfd {
	pinctrl-0 = <&can2_pins &can3_pins>;
	pinctrl-names = "default";
	status = "okay";

	channel2 {
		status = "okay";
	};

	channel3 {
		status = "okay";
	};
};

&cmtw0 {
	status = "okay";
};

&cmtw1 {
	status = "okay";
};

&cru0 {
	status = "okay";
};

&cru1 {
	status = "okay";
};

&cru2 {
	status = "okay";
};

&cru3 {
	status = "okay";
};

&csi20 {
	status = "okay";
};

&csi21 {
	status = "okay";
};

&csi22 {
	status = "okay";
};

&csi23 {
	status = "okay";
};

&drpai0 {
	memory-region = <&drp_reserved>;
	image-memory-region = <&image_buf0>;
	status = "okay";
};

&dsi0 {
	status = "okay";
	ports {
		port@1 {
			dsi0_out: endpoint {
				remote-endpoint = <&adv7535_in>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&du {
	status = "okay";
};

&ehci0 {
	memory-region = <&global_cma>;
	dr_mode = "otg";
	status = "okay";
};

&ehci1 {
	memory-region = <&global_cma>;
	status = "okay";
};

&eth0 {
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		phy0: ethernet-phy@0 {
			compatible = "ethernet-phy-id0022.1640",
						 "ethernet-phy-ieee802.3-c22";
			reg = <0>;
			rxc-skew-psec = <1400>;
			txc-skew-psec = <1400>;
			rxdv-skew-psec = <0>;
			txdv-skew-psec = <0>;
			rxd0-skew-psec = <0>;
			rxd1-skew-psec = <0>;
			rxd2-skew-psec = <0>;
			rxd3-skew-psec = <0>;
			txd0-skew-psec = <0>;
			txd1-skew-psec = <0>;
			txd2-skew-psec = <0>;
			txd3-skew-psec = <0>;
		};
	};
};

&eth1 {
	phy-handle = <&phy1>;
	phy-mode = "rgmii-id";
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		phy1: ethernet-phy@0 {
			compatible = "ethernet-phy-id0022.1640",
						 "ethernet-phy-ieee802.3-c22";
			reg = <0>;
			rxc-skew-psec = <1400>;
			txc-skew-psec = <1400>;
			rxdv-skew-psec = <0>;
			txdv-skew-psec = <0>;
			rxd0-skew-psec = <0>;
			rxd1-skew-psec = <0>;
			rxd2-skew-psec = <0>;
			rxd3-skew-psec = <0>;
			txd0-skew-psec = <0>;
			txd1-skew-psec = <0>;
			txd2-skew-psec = <0>;
			txd3-skew-psec = <0>;
		};
	};
};

&extal_clk {
	clock-frequency = <24000000>;
};

&hsusb {
	dr_mode = "otg";
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c4 {
	pinctrl-0 = <&i2c4_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c5 {
	pinctrl-0 = <&i2c5_pins>;
	pinctrl-names = "default";
	status = "okay";

	adv7535: hdmi@3d {
		compatible = "adi,adv7535";
		reg = <0x3d>;

		avdd-supply = <&reg_1p8v>;
		dvdd-supply = <&reg_1p8v>;
		pvdd-supply = <&reg_1p8v>;
		a2vdd-supply = <&reg_1p8v>;
		v3p3-supply = <&reg_3p3v>;
		v1p2-supply = <&reg_1p8v>;

		interrupt-parent = <&pinctrl>;
		interrupts = <RZG2L_GPIO(10, 4) IRQ_TYPE_LEVEL_LOW>;

		adi,dsi-lanes = <4>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				adv7535_in: endpoint@0 {
					remote-endpoint = <&dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;
				adv7535_out: endpoint@1 {
				remote-endpoint = <&hdmi_con_out>;
				};
			};
		};
	};
};

&i2c6 {
	pinctrl-0 = <&i2c6_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c7 {
	pinctrl-0 = <&i2c7_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c8 {
	pinctrl-0 = <&i2c8_pins>;
	pinctrl-names = "default";
	status = "okay";

#if CODEC_SGTLT5000
	sgtl5000: audio-codec@a {
		compatible = "fsl,sgtl5000";
		#sound-dai-cells = <0>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0xa>;

		//clocks = <&rcar_sound>;
		clocks = <&clk_ext_audio>;
		clock-names = "mclk";

		VDDA-supply = <&reg_3p3v>;
		VDDIO-supply = <&reg_1p8v>;
		VDDD-supply = <&reg_1p8v>;
	};
#else
	es8388: audio-codec@10 {
        compatible = "everest,es8388";
		#sound-dai-cells = <0>;
		#address-cells = <1>;
		#size-cells = <0>;
        reg = <0x10>;

        AVDD-supply  = <&reg_3p3v>;
        DVDD-supply  = <&reg_1p8v>;
        PVDD-supply  = <&reg_3p3v>;
        IPVDD-supply = <&reg_3p3v>;

        clocks = <&clk_ext_audio>;
        clock-names = "mclk";

        status = "okay";
    };
#endif
};

&ohci0 {
	memory-region = <&global_cma>;
	dr_mode = "otg";
	status = "okay";
};

&ohci1 {
	memory-region = <&global_cma>;
	status = "okay";
};

&ostm2 {
	status = "okay";
};

&ostm3 {
	status = "okay";
};

&pcie0 {
	// Map all possible DDR as inbound ranges
	dma-ranges = <0x42000000 0 0x40000000 0 0x40000000 0x2 0x00000000>;
	status = "okay";
};

&rcar_sound {
	pinctrl-0 = <&sound_clk_pins &sound_pins>;
	pinctrl-names = "default";
	status = "okay";

	/* audio_clkout */
	#clock-cells = <0>;
	clock-frequency = <11289600>;

	/* Multi DAI */
	#sound-dai-cells = <1>;

	rcar_sound,dai {
		dai0 {
			playback = <&ssi1>;
			capture  = <&ssi2 &src0 &dvc0>;
		};
	};
};

&rtc {
	status = "okay";
};

/* console */
&scif0 {
	pinctrl-0 = <&scif0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&sci0 {
	pinctrl-0 = <&uart0_pins>;
	pinctrl-names = "default";

	uart-has-rtscts;
	status = "okay";
};

&sci3 {
	pinctrl-0 = <&uart3_pins>;
	pinctrl-names = "default";

	uart-has-rtscts;
	status = "okay";
};

&sci5 {
	status = "disabled";
};

&sci7 {
	status = "disabled";
};

/* eMMC */
&sdhi0 {
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;
	bus-width = <8>;
	mmc-hs200-1_8v;
	non-removable;
	fixed-emmc-driver-type = <1>;
	status = "okay";
};

/* microSD */
&sdhi1 {
	pinctrl-0 = <&sdhi1_pins>;
	pinctrl-names = "default";
	vmmc-supply = <&vmmc_sdhi1>;
	vqmmc-supply = <&vccq_sdhi1>;
	//vqmmc-supply = <&reg_1p8v>;
	bus-width = <4>;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	status = "okay";
};

&sdhi2 {
	pinctrl-0 = <&sdhi2_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&ssi2 {
	shared-pin;
};

&usb20phyrst {
	status = "okay";
};

&usb21phyrst {
	status = "okay";
};

&usb2_phy0 {
	pinctrl-0 = <&usb20_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&usb2_phy1 {
	pinctrl-0 = <&usb21_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&wdt1 {
	status = "okay";
};

&xhci0 {
	pinctrl-0 = <&usb30_pins>;
	pinctrl-names = "default";
	memory-region = <&global_cma>;
	status = "okay";
};

&xhci1 {
	pinctrl-0 = <&usb31_pins>;
	pinctrl-names = "default";
	memory-region = <&global_cma>;
	status = "okay";
};

&xspi {
	status = "okay";

	flash@0 {
		compatible = "micron,mt25qu512a", "jedec,spi-nor";
		reg = <0>;
		m25p,fast-read;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@000000 {
				label = "bl2";
				reg = <0x00000000 0x0001D200>;
				read-only;
			};

			partition@01D200 {
				label = "fip";
				reg = <0x0001D200 0x001C2E00>;
				read-only;
			};

			partition@1E0000 {
				label = "env";
				reg = <0x001E0000 0x00020000>;
				read-only;
			};

			partition@200000 {
				label = "test-area";
				reg = <0x00200000 0x00E00000>;
			};
		};
	};
};

&pinctrl {
	can2_pins: can2 {
		pinmux = <RZG2L_PORT_PINMUX(8,5,5)>, /* CAN2_RX */
				 <RZG2L_PORT_PINMUX(8,4,5)>; /* CAN2_TX */
	};

	can3_pins: can3 {
		pinmux = <RZG2L_PORT_PINMUX(8,7,5)>, /* CAN3_RX */
				 <RZG2L_PORT_PINMUX(8,6,5)>; /* CAN3_TX */
	};

	i2c1_pins: i2c1 {
		pinmux = <RZG2L_PORT_PINMUX(3, 2, 1)>, /* I2C1_SDA */
				 <RZG2L_PORT_PINMUX(3, 3, 1)>; /* I2C1_SCL */
	};

	i2c4_pins: i2c4 {
		pinmux = <RZG2L_PORT_PINMUX(7,1,1)>, /* I2C4_SCL */
				 <RZG2L_PORT_PINMUX(7,0,1)>; /* I2C4_SDA */
	};

	i2c5_pins: i2c5 {
		pinmux = <RZG2L_PORT_PINMUX(7,3,1)>, /* I2C5_SCL */
				 <RZG2L_PORT_PINMUX(7,2,1)>; /* I2C5_SDA */
	};

	i2c6_pins: i2c6 {
		pinmux = <RZG2L_PORT_PINMUX(7,5,1)>, /* I2C6_SCL */
				 <RZG2L_PORT_PINMUX(7,4,1)>; /* I2C6_SDA */
	};

	i2c7_pins: i2c7 {
		pinmux = <RZG2L_PORT_PINMUX(7,7,1)>, /* I2C7_SCL */
				 <RZG2L_PORT_PINMUX(7,6,1)>; /* I2C7_SDA */
	};

	i2c8_pins: i2c8 {
		pinmux = <RZG2L_PORT_PINMUX(0, 6, 1)>, /* I2C8_SDA */
				 <RZG2L_PORT_PINMUX(0, 7, 1)>; /* I2C8_SCL */
	};

	i2c9_pins: i2c9 {
		pinmux = <RZG2L_PORT_PINMUX(8,3,6)>, /* I2C9_SCL */
				 <RZG2L_PORT_PINMUX(8,2,6)>; /* I2C9_SDA */
	};

	scif0_pins: scif0 {
		pins =  "SCIF_RXD", "SCIF_TXD";
	};

	sdhi1_pins: sd1 {
		sd1_mux {
			pinmux = <RZG2L_PORT_PINMUX(9, 4, 14)>; /* SD1_CD */
		};
	};

	sdhi2_pins: sd2 {
		pinmux = <RZG2L_PORT_PINMUX(11, 0, 1)>, /* SD2_CLK */
				 <RZG2L_PORT_PINMUX(11, 5, 1)>, /* SD2_CMD */
				 <RZG2L_PORT_PINMUX(11, 1, 1)>, /* SD2_DATA0 */
				 <RZG2L_PORT_PINMUX(11, 2, 1)>, /* SD2_DATA1 */
				 <RZG2L_PORT_PINMUX(11, 3, 1)>, /* SD2_DATA2 */
				 <RZG2L_PORT_PINMUX(11, 4, 1)>; /* SD2_DATA3 */
	};

	sound_clk_pins: sound_clk {
		pinmux = <RZG2L_PORT_PINMUX(1, 0, 7)>, /* AUDIO_CLKB */
				 <RZG2L_PORT_PINMUX(1, 1, 7)>, /* AUDIO_CLKC */
				 <RZG2L_PORT_PINMUX(9, 7, 8)>; /* AUDIO_CLKOUT */
	};

	sound_pins: sound {
		pinmux = <RZG2L_PORT_PINMUX(4,4,7)>, /* SSI1_SCK */
				 <RZG2L_PORT_PINMUX(4,5,7)>, /* SSI1_WS */
				 <RZG2L_PORT_PINMUX(4,6,7)>, /* SSI1_SDATA */
				 <RZG2L_PORT_PINMUX(4,7,7)>; /* SSI2_SDATA */
	};

	spi1_pins: spi1 {
		pinmux = <RZG2L_PORT_PINMUX(9,1,1)>, /* MISOA */
				 <RZG2L_PORT_PINMUX(9,0,1)>, /* MOSIA */
				 <RZG2L_PORT_PINMUX(9,2,1)>, /* RSPCKA */
				 <RZG2L_PORT_PINMUX(9,3,1)>; /* SSLA0 */
	};

	uart0_pins: uart0 {
		pinmux = <RZG2L_PORT_PINMUX(5,2,4)>, /* UART0_CTS */
				 <RZG2L_PORT_PINMUX(5,1,1)>, /* UART0_RXD */
				 <RZG2L_PORT_PINMUX(5,3,2)>, /* UART0_RTS */
				 <RZG2L_PORT_PINMUX(5,0,1)>; /* UART0_TXD */
	};

	uart3_pins: uart3 {
		pinmux = <RZG2L_PORT_PINMUX(3,6,4)>, /* CTS3N */
				 <RZG2L_PORT_PINMUX(3,5,2)>, /* RXD3_MISO3_SCL3 */
				 <RZG2L_PORT_PINMUX(3,7,2)>, /* SS3_CTS3N_RTS3N */
				 <RZG2L_PORT_PINMUX(3,4,2)>; /* TXD3_MOSI3_SDA3 */
	};

	usb20_pins: usb20 {
		pinmux = <RZG2L_PORT_PINMUX(6,1,15)>, /* USB20_OVRCURN */
				 <RZG2L_PORT_PINMUX(6,0,15)>; /* USB20_VBUSEN */
	};

	usb21_pins: usb21 {
		pinmux = <RZG2L_PORT_PINMUX(6,3,15)>, /* USB21_OVRCURN */
				 <RZG2L_PORT_PINMUX(6,2,15)>; /* USB21_VBUSEN */
	};

	usb30_pins: usb30 {
		pinmux = <RZG2L_PORT_PINMUX(6,5,15)>, /* USB30_OVRCURN */
				 <RZG2L_PORT_PINMUX(6,4,15)>; /* USB30_VBUSEN */
	};

	usb31_pins: usb31 {
		pinmux = <RZG2L_PORT_PINMUX(6,7,15)>, /* USB31_OVRCURN */
				 <RZG2L_PORT_PINMUX(6,6,15)>; /* USB31_VBUSEN */
	};
};
