/*
 * Device Tree Source for the OneKiwi RZ/V2L board
 *
 * Copyright (C) 2021 Renesas Electronics Corp.
 */

/dts-v1/;

#include "onekiwi-r9a07g054l2.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>

#define HDMI_ADV7535	0
#define HDMI_LT8912B	1
#define HDMI_LT9611		0
#define PANEL_PH720128	0

/ {
	model = "OneKiwi RZ/V2L";
	compatible = "renesas,smarc-evk", "renesas,r9a07g054l2", "renesas,r9a07g054";

	aliases {
		serial0 = &scif0;
		serial1 = &scif1;
		serial2 = &scif2;
		serial3 = &scif3;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		mmc0 = &sdhi0;
		mmc1 = &sdhi1;
		ethernet0 = &eth0;
	};

	/* Chosen Node for Console */
	chosen {
		stdout-path = "serial0:115200n8";  /* Set serial console */
	};

	osc1: cec-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <12000000>;
	};

#if HDMI_ADV7535
	hdmi-out {
		compatible = "hdmi-connector";
		type = "d";
		port {
			hdmi_con_out: endpoint {
				remote-endpoint = <&adv7535_out>;
			};
		};
	};
#endif

#if HDMI_LT8912B
	hdmi-out {
		compatible = "hdmi-connector";
		ddc-i2c-bus = <&i2c0>;
		type = "a";

		port {
			hdmi_con_out: endpoint {
				remote-endpoint = <&dsi_hdmi_bridge_out>;
			};
		};
	};
#endif

#if HDMI_LT9611
	hdmi-out {
		compatible = "hdmi-connector";
		label = "hdmi";
		type = "d";

		port {
			hdmi_con_out: endpoint {
				remote-endpoint = <&lt9611_out>;
			};
		};
	};
#endif

	clk_ext_audio: clk_ext_audio {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <11289600>;
	};

	sound_rzg2l: sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "RZV2L-SGTL5000";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&cpu_dai>;
		simple-audio-card,frame-master = <&cpu_dai>;
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,widgets =
			"Microphone", "Microphone Jack",
			"Headphone", "Headphone Jack",
			"Speaker", "Speaker Ext",
			"Line", "Line In Jack";
		simple-audio-card,routing =
			"MIC_IN", "Microphone Jack",
			"Microphone Jack", "Mic Bias",
			"LINE_IN", "Line In Jack",
			"Headphone Jack", "HP_OUT",
			"Speaker Ext", "LINE_OUT";

		cpu_dai: simple-audio-card,cpu {
			sound-dai = <&ssi0>;
			system-clock-frequency = <11289600>;
		};
		codec_dai: simple-audio-card,codec {
			sound-dai = <&sgtl5000>;
			//clocks = <&versa3 3>;
		};
	};

	/* Reserved memory regions */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* device specific region for contiguous allocations */
		drp_reserved: DRP-AI {
			reusable;
			reg = <0x0 0x80000000 0x0 0x20000000>;
		};

		image_buf0: image_buf@0 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0xB0000000 0x0 0x04000000>;
			label = "image_buf0";
		};

		isp_work0: SIMPLE_ISP {
			reusable;
			reg = <0x0 0xB4000000 0x0 0x03000000>;
		};

		global_cma: linux,cma@58000000 {
			compatible = "shared-dma-pool";
			linux,cma-default;
			reusable;
			reg = <0x0 0x58000000 0x0 0x10000000>;
		};

		mmp_reserved: linux,multimedia {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x00000000 0x68000000 0x0 0x8000000>;
		};
	};

	udmabuf@0 {
		compatible = "ikwzm,u-dma-buf";
		device-name = "udmabuf0";
		minor-number = <0>;
		size = <0x4000000>; // 64MiB
		dma-coherent;
		memory-region = <&image_buf0>;
	};

	/* Memory Node */
	memory@48000000 {
		device_type = "memory";
		/* first 128MB is reserved for secure area. */
		reg = <0x0 0x48000000 0x0 0x78000000>;
	};

	mmngr {
		compatible = "renesas,mmngr";
		memory-region = <&mmp_reserved>;
	};

	mmngrbuf {
		compatible = "renesas,mmngrbuf";
	};

	vspm_if {
		compatible = "renesas,vspm_if";
	};

	/* Voltage Regulators */
	reg_1p1v: regulator-vdd-core {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.1V";
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_1p8v: regulator0 {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3v: regulator1 {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	/* GPIO-controlled regulator for SD card interface */
	vccq_sdhi1: regulator-vccq-sdhi1 {
		compatible = "regulator-gpio";
		regulator-name = "SDHI1 VccQ";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		gpios-states = <1>;
		states = <3300000 1>, <1800000 0>;
	};

	ov5645_vdddo_1v8: 1p8v {
		compatible = "regulator-fixed";
		regulator-name = "camera_vdddo";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	ov5645_vdda_2v8: 2p8v {
		compatible = "regulator-fixed";
		regulator-name = "camera_vdda";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-always-on;
	};

	ov5645_vddd_1v5: 1p5v {
		compatible = "regulator-fixed";
		regulator-name = "camera_vddd";
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
		regulator-always-on;
	};

	ov5645_fixed_clk: osc25250-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&gpt2 0 40000 0>;
		brightness-levels = <0 8 32 64 96 128 160 192 224 255>;
		default-brightness-level = <8>;
		status = "okay";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";

		nmi {
			interrupt-parent = <&irqc>;
			interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
			linux,code = <4>;
			label = "NMI";
			debounce-interval = <10>;
			wakeup-source;
		};

		user {
			interrupt-parent = <&pinctrl>;
			interrupts = <RZG2L_GPIO(43, 1) IRQ_TYPE_LEVEL_LOW>;
			linux,code = <KEY_1>;
			label = "user";
			debounce-interval = <10>;
			wakeup-source;
		};
	};

	leds {
		compatible = "gpio-leds";

		led1 {
			gpios = <&pinctrl RZG2L_GPIO(35, 0) GPIO_ACTIVE_LOW>;
			label = "led1";
			default-state = "on";
			linux,default-trigger = "heartbeat";
		};

		led2 {
			gpios = <&pinctrl RZG2L_GPIO(35, 1) GPIO_ACTIVE_LOW>;
			label = "led2";
			default-state = "on";
			linux,default-trigger = "heartbeat";
		};
	};
};

&audio_clk1{
	clock-frequency = <11289600>;
};

&audio_clk2{
	clock-frequency = <12288000>;
};

&csi2 {
	status = "okay";

	ports {
		port@0 {
			csi2_in: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				remote-endpoint = <&ov5645_ep>;
			};
		};
	};
};

&cru {
	status = "okay";
};

&drpai0 {
	memory-region = <&drp_reserved>;
	linux-memory-region = < &{/memory@48000000} >;
	status = "okay";
};

&dsi {
	status = "okay";

#if HDMI_ADV7535
	ports {
		port@1 {
			dsi0_out: endpoint {
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&adv7535_in>;
			};
		};
	};
#endif

#if HDMI_LT8912B
	ports {
		port@1 {
			reg = <1>;
			dsi0_out: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&dsi_hdmi_bridge_in>;
			};
		};
	};
#endif

#if HDMI_LT9611
	ports {
		port@1 {
			dsi_out: endpoint {
				remote-endpoint = <&lt9611_in>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
#endif

#if PANEL_PH720128
	#address-cells = <1>;
	#size-cells = <0>;

	ports {
		port@1 {
			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
				data-lanes = <1 2>;
			};
		};
	};

	mipi_panel: panel@0 {
		compatible = "ilitek,ph720128t005";
		reg = <0>;
		power-gpios = <&pinctrl RZG2L_GPIO(42, 4) GPIO_ACTIVE_HIGH>;
		switch-gpios = <&pinctrl RZG2L_GPIO(43, 2) GPIO_ACTIVE_HIGH>;
		backlight = <&backlight>;
		status = "okay";

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
#endif
};

/* Display Unit configuration */
&du {
	status = "okay";
#if HDMI_ADV7535
	dsi-lanes = <4>;
#endif

#if HDMI_LT9611
	dsi-lanes = <4>;
#endif

#if PANEL_PH720128
	dsi-lanes = <2>;
#endif
};

/* USB EHCI controller 0 (USB 2.0 host) */
&ehci0 {
	dr_mode = "otg";
	status = "okay";
	memory-region = <&global_cma>;
};

/* USB EHCI controller 1 (USB 2.0 host) */
&ehci1 {
	status = "okay";
	memory-region = <&global_cma>;
};

/* Ethernet controller configuration */
&eth0 {
	pinctrl-0 = <&eth0_pins>;
	pinctrl-names = "default";
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	status = "okay";

	/* Ethernet PHY configuration */
	phy0: ethernet-phy@7 {
		compatible = "ethernet-phy-id0022.1640",
					 "ethernet-phy-ieee802.3-c22";
		reg = <7>;
		rxc-skew-psec = <2400>;
		txc-skew-psec = <2400>;
		rxdv-skew-psec = <0>;
		txen-skew-psec = <0>;
		rxd0-skew-psec = <0>;
		rxd1-skew-psec = <0>;
		rxd2-skew-psec = <0>;
		rxd3-skew-psec = <0>;
		txd0-skew-psec = <0>;
		txd1-skew-psec = <0>;
		txd2-skew-psec = <0>;
		txd3-skew-psec = <0>;

		interrupt-parent = <&pinctrl>;
		interrupts = <RZG2L_GPIO(1, 0) IRQ_TYPE_LEVEL_LOW>;
	};
};

/* External clock configuration */
&extal_clk {
	clock-frequency = <24000000>;
};

&gpt2 {
	pinctrl-0 = <&gpt2_pins>;
	pinctrl-names = "default";
	channel="channel_A";
	//poeg = <&poegd>;
	status = "okay";
};

&gpu {
	status = "okay";
	mali-supply = <&reg_1p1v>;
};

&i2c0 {
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";
	status = "okay";

#if HDMI_ADV7535
	adv7535: hdmi@3d {
		compatible = "adi,adv7535";
		reg = <0x3d>;

		interrupt-parent = <&pinctrl>;
		interrupts = <RZG2L_GPIO(1, 1) IRQ_TYPE_EDGE_FALLING>;
		clocks = <&osc1>;
		clock-names = "cec";
		avdd-supply = <&reg_1p8v>;
		dvdd-supply = <&reg_1p8v>;
		pvdd-supply = <&reg_1p8v>;
		a2vdd-supply = <&reg_1p8v>;
		v3p3-supply = <&reg_3p3v>;
		v1p2-supply = <&reg_1p8v>;

		adi,dsi-lanes = <4>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				adv7535_in: endpoint {
					remote-endpoint = <&dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;
				adv7535_out: endpoint {
					remote-endpoint = <&hdmi_con_out>;
				};
			};
		};
	};
#endif

#if HDMI_LT8912B
	dsi_hdmi_bridge: dsihdmi@48 {
		compatible = "lontium,lt8912b";
		reg = <0x48>;
		reset-gpios = <&pinctrl RZG2L_GPIO(43, 3) GPIO_ACTIVE_LOW>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				dsi_hdmi_bridge_in: endpoint@0 {
					data-lanes = <0 1 2 3>;
					remote-endpoint = <&dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;
				dsi_hdmi_bridge_out: endpoint@1 {
					remote-endpoint = <&hdmi_con_out>;
				};
			};
		};
	};
#endif

#if HDMI_LT9611
	lt9611: hdmi-bridge@3b {
		compatible = "lontium,lt9611";
		reg = <0x3b>;
		reset-gpios = <&pinctrl RZG2L_GPIO(43, 3) GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&pinctrl RZG2L_GPIO(1, 1) IRQ_TYPE_EDGE_FALLING>;
		vdd-supply = <&reg_1p8v>;
		vcc-supply = <&reg_3p3v>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				lt9611_in: endpoint {
					remote-endpoint = <&dsi_out>;
					data-lanes = <1 2 3 4>;
				};
			};
			port@1 {
				reg = <1>;
				lt9611_out: endpoint {
					remote-endpoint = <&hdmi_con_out>;
				};
			};
		};
	};
#endif

#if PANEL_PH720128
	gt911: gt911_ts@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;

		interrupt-parent = <&pinctrl>;
		interrupts = <RZG2L_GPIO(1, 1) IRQ_TYPE_EDGE_FALLING>;
		irq-gpios = <&pinctrl RZG2L_GPIO(1, 1) GPIO_ACTIVE_HIGH>;   /* DSI_TS_nINT */
		reset-gpios = <&pinctrl RZG2L_GPIO(43, 3) GPIO_ACTIVE_HIGH>; /* DSI_TS_RST */
		touchscreen-size-x = <720>;
		touchscreen-size-y = <1280>;
		status = "okay";
	};
#endif
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c2 {
	pinctrl-0 = <&i2c2_pins>;
	pinctrl-names = "default";
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	ov5645: camera@3c {
		compatible = "ovti,ov5645";
		reg = <0x3c>;
		clocks = <&ov5645_fixed_clk>;
		clock-frequency = <24000000>;
		vdddo-supply = <&ov5645_vdddo_1v8>;
		vdda-supply = <&ov5645_vdda_2v8>;
		vddd-supply = <&ov5645_vddd_1v5>;
		enable-gpios = <&pinctrl RZG2L_GPIO(11, 1) GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl RZG2L_GPIO(12, 0) GPIO_ACTIVE_LOW>;

		port {
			ov5645_ep: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				remote-endpoint = <&csi2_in>;
			};
		};
	};
};

&i2c3 {
	pinctrl-0 = <&i2c3_pins>;
	pinctrl-names = "default";
	clock-frequency = <100000>;
	status = "okay";

	sgtl5000: audio-codec@a {
		#sound-dai-cells = <0>;
		compatible = "fsl,sgtl5000";
		reg = <0xa>;
		VDDIO-supply = <&reg_3p3v>;
		VDDA-supply = <&reg_3p3v>;
		VDDD-supply = <&reg_1p8v>;
		clocks = <&clk_ext_audio>;
	};
};

/* USB OHCI controller 0 (USB 1.1 host) */
&ohci0 {
	dr_mode = "otg"; /* Dual-role (host/device) mode with OTG support */
	status = "okay";
	memory-region = <&global_cma>;
};

/* USB OHCI controller 1 (USB 1.1 host) */
&ohci1 {
	status = "okay";
	memory-region = <&global_cma>;
};

/* OS Timer configuration */
&ostm1 {
	status = "okay";
};

&ostm2 {
	status = "okay";
};

/* PHY reset controller */
&phyrst {
	status = "okay";
};

&sbc {
	pinctrl-0 = <&qspi0_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "micron,mt25qu512a", "jedec,spi-nor";
		reg = <0>;
		m25p,fast-read;
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bl2";
				reg = <0x00000000 0x0001c000>;
			};

			partition@1d000 {
			/* fip is at offset 0x200 */
				label = "fip";
				reg = <0x0001d000 0x1fe3000>;
			};

			partition@2000000 {
				label = "user";
				reg = <0x02000000 0x2000000>;
			};

		};
	};
};

/* Serial Interface configuration */
&scif0 {
	pinctrl-0 = <&scif0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&scif1 {
	pinctrl-0 = <&scif1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&scif2 {
	pinctrl-0 = <&scif2_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;
	status = "okay";
};

&scif3 {
	pinctrl-0 = <&scif3_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* eMMC */
&sdhi0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&sdhi0_emmc_pins>;
	pinctrl-1 = <&sdhi0_emmc_pins>;

	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;
	bus-width = <8>;
	mmc-hs200-1_8v;
	non-removable;
	fixed-emmc-driver-type = <1>;
	status = "okay";
};

/* microSD */
&sdhi1 {
	pinctrl-0 = <&sdhi1_pins>;
	pinctrl-1 = <&sdhi1_pins_uhs>;
	pinctrl-names = "default", "state_uhs";

	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;
	bus-width = <4>;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	status = "okay";
};

&spi0 {
	pinctrl-0 = <&spi0_pins>;
	pinctrl-names = "default";
	dmas = <&dmac 0x2e95>, <&dmac 0x2e96>;
	dma-names = "tx", "rx";
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_pins>;
	pinctrl-names = "default";
	dmas = <&dmac 0x2e99>, <&dmac 0x2e9a>;
	dma-names = "tx", "rx";
	status = "okay";
};

&ssi0 {
	pinctrl-0 = <&ssi0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* USB PHY 0 configuration */
&usb2_phy0 {
	pinctrl-0 = <&usb0_pins>;
	pinctrl-names = "default";
	vbus-supply = <&usb0_vbus_otg>;
	status = "okay";
};

/* USB PHY 1 configuration */
&usb2_phy1 {
	pinctrl-0 = <&usb1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* Watchdog Timer configuration */
&wdt0 {
	status = "okay";
	timeout-sec = <60>;
};

&wdt1 {
	status = "okay";
	timeout-sec = <60>;
};

/* Pin Control configuration - defines all the pin muxing for the SoC */
&pinctrl {

	can0_pins: can0 {
		pinmux = <RZG2L_PORT_PINMUX(11,0,2)>, /* CAN0_RX */
				 <RZG2L_PORT_PINMUX(10,1,2)>; /* CAN0_TX */
	};

	can1_pins: can1 {
		pinmux = <RZG2L_PORT_PINMUX(13,0,2)>, /* CAN1_RX */
				 <RZG2L_PORT_PINMUX(12,1,2)>; /* CAN1_TX */
	};

	/* Ethernet pin configuration */
	eth0_pins: eth0 {
		txc {
			pinmux = <RZG2L_PORT_PINMUX(20, 0, 1)>; /* ET0_TXC */
			power-source = <1800>;
			output-enable;
		};

		mux {
			pinmux = <RZG2L_PORT_PINMUX(28, 1, 1)>, /* ET0_LINKSTA */
					 <RZG2L_PORT_PINMUX(27, 1, 1)>, /* ET0_MDC */
					 <RZG2L_PORT_PINMUX(28, 0, 1)>, /* ET0_MDIO */
					 <RZG2L_PORT_PINMUX(20, 1, 1)>, /* ET0_TX_CTL */
					 <RZG2L_PORT_PINMUX(20, 2, 1)>, /* ET0_TXD0 */
					 <RZG2L_PORT_PINMUX(21, 0, 1)>, /* ET0_TXD1 */
					 <RZG2L_PORT_PINMUX(21, 1, 1)>, /* ET0_TXD2 */
					 <RZG2L_PORT_PINMUX(22, 0, 1)>, /* ET0_TXD3 */
					 <RZG2L_PORT_PINMUX(24, 0, 1)>, /* ET0_RXC */
					 <RZG2L_PORT_PINMUX(24, 1, 1)>, /* ET0_RX_CTL */
					 <RZG2L_PORT_PINMUX(25, 0, 1)>, /* ET0_RXD0 */
					 <RZG2L_PORT_PINMUX(25, 1, 1)>, /* ET0_RXD1 */
					 <RZG2L_PORT_PINMUX(26, 0, 1)>, /* ET0_RXD2 */
					 <RZG2L_PORT_PINMUX(26, 1, 1)>; /* ET0_RXD3 */
			power-source = <1800>;
		};
	};

	gpt2_pins: gpt2 {
		pinmux = <RZG2L_PORT_PINMUX(2,0,3)>; /* GTIOC2A_A */
	};

	i2c0_pins: i2c0 {
		pins = "RIIC0_SDA", "RIIC0_SCL";
		input-enable;
	};

	i2c1_pins: i2c1 {
		pins = "RIIC1_SDA", "RIIC1_SCL";
		input-enable;
	};
	
	i2c2_pins: i2c2 {
		pinmux = <RZG2L_PORT_PINMUX(3,1,2)>, /* I2C2_SCL */
				 <RZG2L_PORT_PINMUX(3,0,2)>; /* I2C2_SDA */
	};

	i2c3_pins: i2c3 {
		pinmux = <RZG2L_PORT_PINMUX(18,1,3)>, /* I2C3_SCL */
				 <RZG2L_PORT_PINMUX(18,0,3)>; /* I2C3_SDA */
	};

	/* SCIF0 (Serial Interface) pin configuration */
	scif0_pins: scif0 {
		pinmux = <RZG2L_PORT_PINMUX(38, 0, 1)>,	/* TxD */
				 <RZG2L_PORT_PINMUX(38, 1, 1)>;	/* RxD */
	};

	scif1_pins: scif1 {
		pinmux = <RZG2L_PORT_PINMUX(40,1,1)>, /* SCIF1_RXD */
				 <RZG2L_PORT_PINMUX(40,0,1)>; /* SCIF1_TXD */
	};

	scif2_pins: scif2 {
		pinmux = <RZG2L_PORT_PINMUX(48,3,1)>, /* SCIF2_CTS */
				 <RZG2L_PORT_PINMUX(48,4,1)>, /* SCIF2_RTS */
				 <RZG2L_PORT_PINMUX(48,1,1)>, /* SCIF2_RXD */
				 <RZG2L_PORT_PINMUX(48,0,1)>; /* SCIF2_TXD */
	};

	scif3_pins: scif3 {
		pinmux = <RZG2L_PORT_PINMUX(0,1,5)>, /* SCIF3_RXD */
				 <RZG2L_PORT_PINMUX(0,0,5)>; /* SCIF3_TXD */
	};

	/* eMMC (SDHI0) pin configuration */
	sdhi0_emmc_pins: sd0emmc {
		sd0_emmc_data {
			pins = "SD0_DATA0", "SD0_DATA1", "SD0_DATA2", "SD0_DATA3",
				   "SD0_DATA4", "SD0_DATA5", "SD0_DATA6", "SD0_DATA7";
			power-source = <1800>;
		};

		sd0_emmc_ctrl {
			pins = "SD0_CLK", "SD0_CMD";
			power-source = <1800>;
		};

		sd0_emmc_rst {
			pins = "SD0_RST#";
			power-source = <1800>;
		};
	};

	/* SD Card (SDHI1) pin configuration - 3.3V mode */
	sdhi1_pins: sd1 {
		sd1_data {
			pins = "SD1_DATA0", "SD1_DATA1", "SD1_DATA2", "SD1_DATA3";
			power-source = <3300>;
		};

		sd1_ctrl {
			pins = "SD1_CLK", "SD1_CMD";
			power-source = <3300>;
		};

		sd1_mux {
			pinmux = <RZG2L_PORT_PINMUX(19, 0, 1)>; /* SD1_CD */
		};
	};

	/* SD Card (SDHI1) pin configuration - 1.8V UHS mode */
	sdhi1_pins_uhs: sd1_uhs {
		sd1_data_uhs {
			pins = "SD1_DATA0", "SD1_DATA1", "SD1_DATA2", "SD1_DATA3";
			power-source = <1800>;
		};

		sd1_ctrl_uhs {
			pins = "SD1_CLK", "SD1_CMD";
			power-source = <1800>;
		};

		sd1_mux_uhs {
			pinmux = <RZG2L_PORT_PINMUX(19, 0, 1)>; /* SD1_CD */
		};
	};

	qspi0_pins: qspi0 {
		qspi0-data {
			pins = "QSPI0_IO0", "QSPI0_IO1", "QSPI0_IO2", "QSPI0_IO3";
			power-source = <1800>;
		};

		qspi0-ctrl {
			pins = "QSPI0_SPCLK", "QSPI0_SSL", "QSPI_RESET#";
			power-source = <1800>;
		};
	};

	sound_clk_pins: sound_clk {
		pins = "AUDIO_CLK1", "AUDIO_CLK2";
		input-enable;
	};

	spi0_pins: spi0 {
		pinmux = <RZG2L_PORT_PINMUX(47,0,5)>, /* RSPI0_CK_C */
				 <RZG2L_PORT_PINMUX(47,2,5)>, /* RSPI0_MISO_C */
				 <RZG2L_PORT_PINMUX(47,1,5)>, /* RSPI0_MOSI_C */
				 <RZG2L_PORT_PINMUX(47,3,5)>; /* RSPI0_SSL_C */
	};

	spi1_pins: spi1 {
		pinmux = <RZG2L_PORT_PINMUX(44, 0, 1)>, /* CK */
				 <RZG2L_PORT_PINMUX(44, 1, 1)>, /* MOSI */
				 <RZG2L_PORT_PINMUX(44, 2, 1)>, /* MISO */
				 <RZG2L_PORT_PINMUX(44, 3, 1)>; /* SSL */
	};
	
	ssi0_pins: ssi0 {
		pinmux = <RZG2L_PORT_PINMUX(45, 0, 1)>, /* BCK */
				 <RZG2L_PORT_PINMUX(45, 1, 1)>, /* RCK */
				 <RZG2L_PORT_PINMUX(45, 2, 1)>, /* TXD */
				 <RZG2L_PORT_PINMUX(45, 3, 1)>; /* RXD */
	};

	/* USB0 pin configuration */
	usb0_pins: usb0 {
		pinmux = <RZG2L_PORT_PINMUX(4, 0, 1)>, /* VBUS */
				 <RZG2L_PORT_PINMUX(5, 0, 1)>, /* OVC */
				 <RZG2L_PORT_PINMUX(5, 1, 1)>; /* OTG_ID */
	};

	/* USB1 pin configuration */
	usb1_pins: usb1 {
		pinmux = <RZG2L_PORT_PINMUX(42, 0, 1)>, /* VBUS */
				 <RZG2L_PORT_PINMUX(42, 1, 1)>; /* OVC */
	};
};
